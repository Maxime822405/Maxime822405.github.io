{
  "name": "tetris-game",
  "version": "1.0.0",
  "description": "Jeu Tetris classique",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-mac": "electron-builder --mac",
    "build-dmg": "electron-builder --mac dmg",
    "package-mac": "electron-packager . Tetris --platform=darwin --arch=x64 --icon=icon.icns --overwrite"
  },
  "author": "Maxime",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.maxime.tetris",
    "productName": "Tetris",
    "mac": {
      "category": "public.app-category.games",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "dmg": {
      "title": "Tetris Game",
      "icon": "icon.icns",
      "background": "background.png",
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
